<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>


<script>

/* =====================================================
   SUPABASE CONFIGURATION
===================================================== */

const SUPABASE_URL =
    "https://nhjapidacizvhebtpzah.supabase.co";

const SUPABASE_ANON_KEY =
    "sb_publishable_wCblAx3NmcI7V8dR-_VL_w_vFmvfdhV";


const supabaseClient =
    window.supabase.createClient(
        SUPABASE_URL,
        SUPABASE_ANON_KEY
    );



/* =====================================================
   LOAD PROJECTS
===================================================== */

async function loadProjects() {

    try {

        const {
            data,
            error
        } = await supabaseClient

            .from("construction_projects")

            .select(
                "id, category, title, location, description, image_urls, created_at"
            )

            .eq("published", true)

            .order(
                "created_at",
                {
                    ascending: false
                }
            );


        if (error) {

            console.error(
                "Supabase error:",
                error
            );

            showError();

            return;

        }


        hideLoading();


        const projects =
            data || [];


        renderProjects(
            projects,
            "Interior"
        );


        renderProjects(
            projects,
            "Exterior"
        );


    } catch (error) {

        console.error(
            "Unexpected error:",
            error
        );

        showError();

    }

}



/* =====================================================
   RENDER PROJECTS
===================================================== */

function renderProjects(
    allProjects,
    category
) {

    const containerId =
        category.toLowerCase() +
        "Projects";


    const loadingId =
        category.toLowerCase() +
        "Loading";


    const emptyId =
        category.toLowerCase() +
        "Empty";


    const container =
        document.getElementById(
            containerId
        );


    const emptyMessage =
        document.getElementById(
            emptyId
        );


    const loading =
        document.getElementById(
            loadingId
        );


    if (!container) {
        return;
    }


    if (loading) {
        loading.style.display = "none";
    }


    container.innerHTML = "";


    const projects =
        allProjects.filter(
            project =>
                String(project.category)
                    .toLowerCase()
                    === category.toLowerCase()
        );


    if (projects.length === 0) {

        if (emptyMessage) {
            emptyMessage.style.display =
                "block";
        }

        return;

    }


    if (emptyMessage) {
        emptyMessage.style.display =
            "none";
    }


    projects.forEach(
        project => {

            const projectElement =
                createProjectElement(
                    project
                );


            container.appendChild(
                projectElement
            );

        }
    );

}



/* =====================================================
   CREATE PROJECT ELEMENT
===================================================== */

function createProjectElement(
    project
) {

    const projectDiv =
        document.createElement("div");


    projectDiv.className =
        "project";


    /* -----------------------------------------
       PROJECT INFORMATION
    ----------------------------------------- */

    const infoDiv =
        document.createElement("div");


    infoDiv.className =
        "project-info";


    const title =
        document.createElement("h4");


    title.textContent =
        project.title ||
        "Construction Project";


    infoDiv.appendChild(
        title
    );


    if (project.location) {

        const location =
            document.createElement("div");


        location.className =
            "project-location";


        location.textContent =
            project.location;


        infoDiv.appendChild(
            location
        );

    }


    if (project.description) {

        const description =
            document.createElement("p");


        description.className =
            "project-description";


        description.textContent =
            project.description;


        infoDiv.appendChild(
            description
        );

    }


    projectDiv.appendChild(
        infoDiv
    );


    /* -----------------------------------------
       PHOTO GALLERY
    ----------------------------------------- */

    const photoGrid =
        document.createElement("div");


    photoGrid.className =
        "photo-grid";


    let imageUrls =
        project.image_urls;


    /*
       Supabase may return image_urls
       as an array, JSON string,
       or occasionally null.
    */

    if (typeof imageUrls === "string") {

        try {

            imageUrls =
                JSON.parse(imageUrls);

        } catch {

            imageUrls =
                [imageUrls];

        }

    }


    if (!Array.isArray(imageUrls)) {

        imageUrls = [];

    }


    imageUrls.forEach(
        imageUrl => {

            if (!imageUrl) {
                return;
            }


            const photo =
                document.createElement("div");


            photo.className =
                "photo";


            const image =
                document.createElement("img");


            image.src =
                imageUrl;


            image.alt =
                project.title ||
                "Miju Construction Project";


            image.loading =
                "lazy";


            image.onerror =
                function() {

                    photo.style.display =
                        "none";

                };


            photo.appendChild(
                image
            );


            photo.addEventListener(
                "click",
                function() {

                    openLightbox(
                        imageUrl,
                        image.alt
                    );

                }
            );


            photoGrid.appendChild(
                photo
            );

        }
    );


    /*
       If there are no photos,
       don't show an empty gallery.
    */

    if (imageUrls.length > 0) {

        projectDiv.appendChild(
            photoGrid
        );

    }


    return projectDiv;

}



/* =====================================================
   LIGHTBOX
===================================================== */

function openLightbox(
    imageUrl,
    altText
) {

    const lightbox =
        document.getElementById(
            "lightbox"
        );


    const lightboxImage =
        document.getElementById(
            "lightboxImage"
        );


    lightboxImage.src =
        imageUrl;


    lightboxImage.alt =
        altText || "Construction project photo";


    lightbox.classList.add(
        "active"
    );


    document.body.style.overflow =
        "hidden";

}



/* =====================================================
   CLOSE LIGHTBOX
===================================================== */

function closeLightbox(
    event
) {

    if (event) {

        event.stopPropagation();

    }


    const lightbox =
        document.getElementById(
            "lightbox"
        );


    lightbox.classList.remove(
        "active"
    );


    document.body.style.overflow =
        "";

}



/* =====================================================
   ESC KEY
===================================================== */

document.addEventListener(
    "keydown",
    function(event) {

        if (
            event.key === "Escape"
        ) {

            closeLightbox();

        }

    }
);



/* =====================================================
   HIDE LOADING
===================================================== */

function hideLoading() {

    const loadingElements =
        document.querySelectorAll(
            ".loading"
        );


    loadingElements.forEach(
        element => {

            element.style.display =
                "none";

        }
    );

}



/* =====================================================
   SHOW ERROR
===================================================== */

function showError() {

    hideLoading();


    const error =
        document.getElementById(
            "errorMessage"
        );


    if (error) {

        error.style.display =
            "block";

    }

}



/* =====================================================
   START
===================================================== */

loadProjects();

</script>


